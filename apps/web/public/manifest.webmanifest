{
  "name": "FiberGIS Field",
  "short_name": "FiberGIS",
  "description": "Phone capture of poles, boxes, drops, light levels and danger, for FiberGIS.",
  "start_url": "/capture",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f8fafc",
