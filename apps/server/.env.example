# Copy this file to apps/server/.env (git ignores .env) and fill in your own values.
# Never commit .env, paste a key into a chat, or put it in the code.

# Voice lessons (Sarvam AI text to speech). Without a key, lessons show text only.
SARVAM_API_KEY=
# bulbul:v4-flash (default) or bulbul:v3
SARVAM_MODEL=bulbul:v4-flash
# Most characters sent to Sarvam per day: a spending guard (default 20000).
SARVAM_DAILY_CHAR_LIMIT=20000
